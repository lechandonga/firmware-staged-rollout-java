<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%logger{24}] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 业务覆盖日志始终输出到控制台 -->
    <logger name="BUSINESS_COVERAGE" level="INFO" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
